    {
      "id": "claim_22a7cfc418d44bdba1f92e9af367a7de",
      "statement": "base_train sizes the model from --depth: model_dim = depth * aspect_ratio rounded up to a multiple of head_dim, n_head = n_kv_head = model_dim // head_dim, with the tokenizer's vocabulary and --window-pattern (default SSSL), built on the meta device then to_empty and init_weights.",
      "evidence": [
        {
          "resource": "repo://scripts/base_train.py#L129-L151",
          "version": "repo-lines-v1:sha256:35062964ee5f1f2d3c7cf05fed45bef5cca28c733bd462a1cf8b176c719817a0:"
        },
        {
