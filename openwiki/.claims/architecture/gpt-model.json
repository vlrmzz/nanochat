    {
      "id": "claim_1f993bb1ea024975a0efd8d68e45cd91",
      "statement": "The forward trunk applies smear (gated previous-token embedding mix, with previous embedding carried in kv_cache.prev_embedding during decode), per-layer resid_lambdas and x0_lambdas blending, and a backout that subtracts backout_lambda times the residual cached after the middle layer before the final norm.",
      "evidence": [
