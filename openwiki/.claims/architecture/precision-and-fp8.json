    {
      "id": "claim_67d685b3ee59453eb31aa2532c2af4e4",
      "statement": "COMPUTE_DTYPE is resolved once at import of nanochat.common: NANOCHAT_DTYPE overrides it (bfloat16, float16 or float32 only), otherwise CUDA compute capability >= 8.0 selects bfloat16, older CUDA GPUs and CPU/MPS default to float32, and the reason string is exposed as COMPUTE_DTYPE_REASON.",
      "evidence": [
        {
          "resource": "repo://nanochat/common.py#L12-L32",
          "version": "repo-lines-v1:sha256:4a1bf89ba0d4d5e05459a18fd9ed239615f798fdf351acd9e65c788fc295dffa:"
        }
      ]
    },
    {
      "id": "claim_25a7b65d183746849196157fcdd94e8a",
      "statement": "nanochat avoids autocast: matrix master weights stay fp32 and the model's Linear casts weights to the activation dtype in forward, embeddings are stored in COMPUTE_DTYPE except under float16, activations are cast to COMPUTE_DTYPE at the start of forward, and logits are cast to fp32 before softcap and loss.",
