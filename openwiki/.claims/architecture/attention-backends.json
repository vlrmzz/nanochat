    {
      "id": "claim_1202a76a20ef422a875859405454b44e",
      "statement": "FA3 availability is resolved once at import time: it requires CUDA, loads the varunneal/flash-attention-3 kernel on Hopper (compute capability major 9) and kernels-community/flash-attn3 elsewhere, and any loading exception is swallowed so the module falls back to SDPA.",
      "evidence": [
        {
          "resource": "repo://nanochat/flash_attention.py#L23-L50",
          "version": "repo-lines-v1:sha256:7128d2415896b49f117c72cc675e03088a9dd8f14e7bc8981558b5b0414284d0:"
        }
      ]
    },
    {
      "id": "claim_a665e34cc75641758746c9c6715c1cbe",
      "statement": "FA3 is only used when it is available and COMPUTE_DTYPE is bfloat16; fp16 and fp32 runs use the SDPA fallback even on FA3-capable GPUs, and a test-only _override_impl can force either backend.",
      "evidence": [
        {
          "resource": "repo://nanochat/flash_attention.py#L53-L71",
          "version": "repo-lines-v1:sha256:5c970f1f5a8c2dc7112892eafad3c758d5665522e4425c578de860fa07ec700a:"
        }
      ]
    },
    {
      "id": "claim_9b45abdd909a42b0843619dc369901bf",
      "statement": "Both public attention functions use FA3's (B, T, H, D) layout with a (left, right) window_size tuple, and the SDPA fallback transposes to (B, H, T, D), enabling GQA when the query and key head counts differ.",
